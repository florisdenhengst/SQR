\begin{tikzpicture}\n\begin{axis}[\n    title={Coverage Error vs Tau},\n    xlabel={$\\tau$},\n    ylabel={coverage},\n    width=0.9\\textwidth,\n    height=6cm,\n    legend pos=outer north east,\n    xtick={0.5,0.6,0.7,0.8,0.9},\n]\n\\addplot[color=green, dotted, mark=square, mark size=2pt] coordinates {(0.5,0.0836) (0.6,0.0827) (0.7,0.0873) (0.8,0.0836) (0.9,0.0640)};\n\\addlegendentry{DecisionTree - coverage}\n\\addplot[color=blue, dashed, mark=o, mark size=2pt] coordinates {(0.5,0.0587) (0.6,0.0620) (0.7,0.0600) (0.8,0.0563) (0.9,0.0383)};\n\\addlegendentry{LightGBM - coverage}\n\\addplot[color=purple, dashdotted, mark=diamond, mark size=2pt] coordinates {(0.5,0.0590) (0.6,0.1069) (0.7,0.1623) (0.8,0.2184) (0.9,0.2727)};\n\\addlegendentry{LinearQuantile - coverage}\n\\addplot[color=red, solid, mark=*, mark size=2pt] coordinates {(0.5,0.0815) (0.6,0.0792) (0.7,0.0733) (0.8,0.0673) (0.9,0.0599)};\n\\addlegendentry{SQR - coverage}\n\end{axis}\n\end{tikzpicture}\n